import tkinter as tk
from tkinter import messagebox
def calculate_interest():
    try:
        # Get user inputs
        principal = float(principal_entry.get())
        rate = float(rate_entry.get())
        time = float(time_entry.get())
        # Simple Interest
        simple_interest = (principal * rate * time) / 100
        # Compound Interest
        amount = principal * (1 + rate/100) ** time
        compound_interest = amount - principal
        # Show results
        messagebox.showinfo("Results",
                            f"Simple Interest: {simple_interest:.2f}\n"
                            f"Compound Interest: {compound_interest:.2f}")
    except ValueError:
        messagebox.showerror("Error", "Please enter valid numbers!")
# Main window
root = tk.Tk()
root.title("Interest Calculator")
# Labels and input fields
tk.Label(root, text="Principal Amount:").grid(row=0, column=0, padx=10, pady=5)
principal_entry = tk.Entry(root)
principal_entry.grid(row=0, column=1)
tk.Label(root, text="Rate of Interest (%):").grid(row=1, column=0, padx=10, pady=5)
rate_entry = tk.Entry(root)
rate_entry.grid(row=1, column=1)
tk.Label(root, text="Time Period (years):").grid(row=2, column=0, padx=10, pady=5)
time_entry = tk.Entry(root)
time_entry.grid(row=2, column=1)
# Button
tk.Button(root, text="Calculate", command=calculate_interest).grid(row=3, column=0, columnspan=2, pady=10)
root.mainloop()