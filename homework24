import pygame
pygame.init()
# Window
screen = pygame.display.set_mode((600, 400))
pygame.display.set_caption("Simple Pygame Example")
# Colors
WHITE = (255, 255, 255)
BLUE = (0, 100, 255)
BLACK = (0, 0, 0)
# Font
font = pygame.font.Font(None, 40)
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    screen.fill(WHITE)
    # Rectangle
    pygame.draw.rect(screen, BLUE, (150, 150, 300, 100))
    # Text
    text = font.render("Hello!", True, BLACK)
    screen.blit(text, (260, 110))
    pygame.display.update()
pygame.quit()