import tkinter as tk
def convert_to_cm():
    try:
        inches = float(entry.get())
        cm = inches * 2.54
        result_label.config(text=f"{cm:.2f} cm")
    except ValueError:
        result_label.config(text="Please enter a valid number")
# Create main window
root = tk.Tk()
root.title("Inches to Centimetres Converter")
root.geometry("300x200")
# Input label
label = tk.Label(root, text="Enter length in inches:")
label.pack(pady=10)
# Input field
entry = tk.Entry(root, width=20)
entry.pack()
# Convert button
button = tk.Button(root, text="Convert", command=convert_to_cm)
button.pack(pady=10)
# Result label
result_label = tk.Label(root, text="", font=("Arial", 14))
result_label.pack(pady=10)
# Run the application
root.mainloop()