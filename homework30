import tkinter as tk
from tkinter import messagebox
from datetime import datetime
def calculate_age():
    dob_str = entry_dob.get()
    try:
        # Convert input string to date object
        dob = datetime.strptime(dob_str, "%d-%m-%Y")
        today = datetime.today()
        # Calculate age
        age_years = today.year - dob.year
        age_months = today.month - dob.month
        age_days = today.day - dob.day
        # Adjust if birthday hasn't occurred yet this year
        if age_days < 0:
            age_months -= 1
        if age_months < 0:
            age_years -= 1
        messagebox.showinfo("Age Result", f"Your age is: {age_years} years")
    except ValueError:
        messagebox.showerror("Invalid Input", "Please enter date in DD-MM-YYYY format")
# Create main window
root = tk.Tk()
root.title("Age Calculator")
root.geometry("300x200")
# Label
label = tk.Label(root, text="Enter your Date of Birth (DD-MM-YYYY):")
label.pack(pady=10)
# Entry box
entry_dob = tk.Entry(root, width=25)
entry_dob.pack(pady=5)
# Button
btn = tk.Button(root, text="Calculate Age", command=calculate_age)
btn.pack(pady=20)
# Run the application
root.mainloop()