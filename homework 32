import tkinter as tk
def calculate_product():
    try:
        num1 = float(entry1.get())
        num2 = float(entry2.get())
        product = num1 * num2
        result_box.delete("1.0", tk.END)
        result_box.insert(tk.END, f"The product is: {product}")
    except ValueError:
        result_box.delete("1.0", tk.END)
        result_box.insert(tk.END, "Please enter valid numbers.")
# Create window
window = tk.Tk()
window.geometry("400x300")
window.title("Getting Started with Widgets")
# Description label
description = tk.Label(window, text="Enter two numbers and get their product.", fg="#333399")
description.pack(pady=10)
# Number 1 label + entry
label1 = tk.Label(window, text="Enter first number:")
label1.pack()
entry1 = tk.Entry(window)
entry1.pack()
# Number 2 label + entry
label2 = tk.Label(window, text="Enter second number:")
label2.pack()
entry2 = tk.Entry(window)
entry2.pack()
# Button to calculate
button = tk.Button(window, text="Calculate Product", command=calculate_product, bg="#66ccff")
button.pack(pady=10)
# Text box for result
result_box = tk.Text(window, height=3, width=30)
result_box.pack()
window.mainloop()