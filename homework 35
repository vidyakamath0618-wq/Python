import tkinter as tk
# This function checks the password strength
def check_strength():
    password = entry.get()      # Get the text the user typed
    length = len(password)      # Count how many characters
    # Decide the strength based on length
    if length == 0:
        result_label.config(text="Please type a password", fg="red")
    elif length < 5:
        result_label.config(text="Weak password", fg="red")
    elif length < 10:
        result_label.config(text="Medium strength", fg="orange")
    else:
        result_label.config(text="Strong password", fg="green")
# Create the main window
root = tk.Tk()
root.title("Password Strength Checker")
# Create a label
label = tk.Label(root, text="Enter your password:")
label.pack(pady=10)
# Create an entry box (password input)
entry = tk.Entry(root, show="*")
entry.pack()
# Create a button
button = tk.Button(root, text="Check Strength", command=check_strength)
button.pack(pady=10)
# Create a label to show the result
result_label = tk.Label(root, text="")
result_label.pack()
# Start the app
root.mainloop()