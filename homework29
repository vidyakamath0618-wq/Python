import pygame
import random
pygame.init()
# Screen
screen = pygame.display.set_mode((600, 400))
pygame.display.set_caption("Player and Enemies")
# Player sprite
player = pygame.Rect(300, 200, 40, 40)
# Enemy sprites (7 random positions)
enemies = []
for i in range(7):
    x = random.randint(0, 560)
    y = random.randint(0, 360)
    enemies.append(pygame.Rect(x, y, 40, 40))
score = 0
font = pygame.font.SysFont(None, 30)
running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False
    keys = pygame.key.get_pressed()
    if keys[pygame.K_UP]:
        player.y -= 5
    if keys[pygame.K_DOWN]:
        player.y += 5
    if keys[pygame.K_LEFT]:
        player.x -= 5
    if keys[pygame.K_RIGHT]:
        player.x += 5
    # Collision check
    for enemy in enemies:
        if player.colliderect(enemy):
            score += 1
            # Move enemy to a new random position
            enemy.x = random.randint(0, 560)
            enemy.y = random.randint(0, 360)
    screen.fill((255, 255, 255))
    # Draw player
    pygame.draw.rect(screen, (0, 0, 255), player)
    # Draw enemies
    for enemy in enemies:
        pygame.draw.rect(screen, (255, 0, 0), enemy)
    # Draw score
    text = font.render("Score: " + str(score), True, (0, 0, 0))
    screen.blit(text, (10, 10))
    pygame.display.update()
pygame.quit()